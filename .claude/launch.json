{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "analysis/.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "apricity_analyze.server"
      ],
      "env": {
        "PYTHONPATH": "analysis"
      },
      "port": 5181
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    }
  ]
}