{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "analysis/.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "apricity_analyze.server"
      ],
      "env": {
        "PYTHONPATH": "analysis"
      },
      "port": 5181,
      "autoPort": true
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "library",
      "runtimeExecutable": "target/release/apricity",
      "runtimeArgs": [
        "serve",
        "--library",
        "/Users/home/Apricity-Library",
        "--port",
        "5190",
        "--web",
        "web/dist"
      ],
      "port": 5190
    }
  ]
}
