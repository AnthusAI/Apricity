# Chop Shop — sampling-style primitives on 1890s marches: a drum loop sliced into eighths and
# re-sequenced, a drum kit assembled from one-shots in two recordings, sliced horns following the
# chords, all swung like a sampler at 58%.
tempo 88
key F mixolydian
samples ../samples

clip brk    = marine-band/stems/Thunderer/drums.wav  loop-1  warp beats
clip horns  = marine-band/stems/Thunderer/other.wav  loop-2
clip tdrums = marine-band/stems/Thunderer/drums.wav
clip pdrums = marine-band/stems/WashingtonPost/drums.wav
clip band   = marine-band/Thunderer.mp3

kit b = slice brk by beats 0.5         # eighth-note slices of the drum loop
kit h = slice horns by beats 1         # one slice per beat of the horn loop

kit drums
  kick  = tdrums  beats 62..62.5      # the loudest beats in each drum stem
  snare = pdrums  beats 70..70.5
  crash = band  shot-3

chords I7 . IV7 . | I7 . V7 IV7

track b            steps "1 _ 2 _ 3 _ 3 4 | 5 _ 6 _ 7 8 7 _"          swing 58  transpose 0
track drums        steps "kick . . . snare . . kick | . kick . . snare . . ."  swing 58  transpose 0  volume -3
track h            steps "1 . . 3 . . 2 . | . . 4 . 3 . . ."          swing 58  follow  filter hp 250  bars 5-8
track drums.crash  at 1 5  transpose 0  volume -8
