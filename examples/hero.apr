# Hero — the landing-page groove: the horns of Sousa's The Thunderer (1889), sliced into four
# stabs on a four-on-the-floor pulse, over the Salamander Drumkit (CC BY-SA 3.0, Alexander Holm).
# Everything plays from bar 1; every bar is a different rhythm instead of a build-up.
# Fetch the kit with: apricity sources fetch salamander-drumkit
tempo 104
key F mixolydian
samples ../samples

clip horns    = marine-band/stems/Thunderer/other.wav  beats 14..18   # four beats whose attacks land on the beat (within 9 ms)

# One-shots are re-pitched: they play as recorded, never stretched to the grid.
clip kick     = salamander-drumkit/OH/kick_OH_F_1.wav         warp repitch
clip snare    = salamander-drumkit/OH/snare_OH_F_1.wav        warp repitch
clip ghost    = salamander-drumkit/OH/snare_OH_Ghost_1.wav    warp repitch
clip stick    = salamander-drumkit/OH/snareStick_OH_F_1.wav   warp repitch
clip hat      = salamander-drumkit/OH/hihatClosed_OH_F_1.wav  warp repitch
clip open     = salamander-drumkit/OH/hihatOpen_OH_F_1.wav    warp repitch
clip tom      = salamander-drumkit/OH/hiTom_OH_F_1.wav        warp repitch
clip floor    = salamander-drumkit/OH/loTom_OH_MP_1.wav       warp repitch
clip crash    = salamander-drumkit/OH/crash1_OH_FF_1.wav      warp repitch

kit h = slice horns by beats 1         # four stabs, one per beat, each starting on a note attack

kit drums
  kick  = kick
  snare = snare
  ghost = ghost
  stick = stick
  hat   = hat
  open  = open
  tom   = tom
  floor = floor
  crash = crash

chords I7 . IV7 . | I7 . V7 IV7

# Horn stabs on every beat, a different order and push each bar.
track h  steps "1 _ _ _ 2 _ _ _ 3 _ _ _ 4 _ _ _ | 1 _ _ 1 _ _ 2 _ . . 3 _ 4 _ _ _ | 1 _ . 3 _ . 1 _ 2 _ _ _ 4 _ 2 _ | 3 _ _ _ 3 _ . . 1 _ 2 _ 4 _ _ _ | 1 _ _ _ 2 _ _ _ 3 _ . 3 4 _ _ _ | 2 _ . 1 _ . 2 _ 1 _ _ _ 4 _ . 3 | 1 _ _ _ 3 _ 1 _ 2 _ . 2 _ . 4 _ | 4 _ _ _ 3 _ _ _ 2 _ _ _ 1 _ 1 1"  follow  filter hp 250  volume -1

# Kick on every beat (with a pushed kick in some bars); the snare backbeat, with ghosts, sticks and
# tom fills changing bar to bar.
track drums.kick  steps "x _ _ _ x _ _ _ x _ _ _ x _ _ _ | x _ _ _ x _ _ _ x _ _ x x _ _ _ | x _ _ _ x _ _ _ x _ _ _ x _ _ _ | x _ _ _ x _ _ _ x _ _ _ x _ x _ | x _ _ _ x _ _ _ x _ _ _ x _ _ _ | x _ _ x x _ _ _ x _ _ _ x _ _ _ | x _ _ _ x _ _ _ x _ x _ x _ _ _ | x _ _ _ x _ _ _ x _ _ _ x _ _ _"  volume +1
track drums  steps ". . . . snare _ _ _ . . . . snare _ _ _ | . . . ghost snare _ _ _ . . ghost . snare _ _ ghost | . . . . snare _ _ stick . . . stick snare _ _ _ | . . . . snare _ ghost . . . . . snare _ tom floor | . . . . snare _ _ _ . . . ghost snare _ ghost . | . . ghost . snare _ _ _ . . . . snare _ stick stick | . . . . snare _ _ ghost . . ghost . snare _ _ _ | . . . . snare _ _ _ . . tom tom floor floor [snare snare] [snare snare]"  volume -9

# Hats: straight eighths, sixteenths, and open hats on the off-beats, a different figure each bar.
track drums.hat   steps ". . x . . . x . . . x . . . x . | x x x x x x x x x x x x x x x x | . . x . . . x . . . x . . . x x | x . x . x . x . x . x . x . x . | . . x . . . x . . . x . . . x . | x x x . x x x . x x x . x x x . | . . x . . . x x . . x . . . x . | x . x . x . x . x . x . . . . ."  volume -9
track drums.open  steps ". . . . . . . . . . . . . . . . | . . . . . . . . . . . . . . . . | . . . . . . . . . . . . . . . . | . . . . . . . . . . . . . . . . | . . x . . . x . . . x . . . x . | . . . . . . . . . . . . . . . . | . . . . . . . . . . x . . . . . | . . . . . . . . . . . . . . . ."  gate 50%  volume -22
track drums.crash  at 1 5  volume -22
