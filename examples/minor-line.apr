# Minor Line — a four-bar tune in D minor for one horn note, in eighth notes: up to the fifth, down through
# the relative major, and home by step. Open it in the Melodies tab and change it on the piano roll.

tempo 96
key D minor
samples ../samples

clip horn   = marine-band/stems/Thunderer/other.wav  shot-7
clip tuba   = marine-band/stems/WashingtonPost/bass.wav  pick 1bar
clip groove = marine-band/stems/Thunderer/drums.wav  loop-1  warp beats

chords i | VI | III | VII

track horn    notes "1 . 3 4 5 _ 4 3 | 1 _ _ . 5, _ 1 _ | 3 . 4 5 7 _ 5 4 | 4 _ _ _ 3 _ 2 _"  grid 8
track tuba    follow  volume -4
track groove  transpose 0  volume -6
