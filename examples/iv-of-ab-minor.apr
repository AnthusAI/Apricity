tempo 116
key Abm
samples ../samples

clip bugle   = citizen-dj/loc-jukebox-popular/Army-bugle-calls_jukebox-118367_001_00-00-56.wav  pick 2bars
clip cotton  = marine-band/KingCotton.mp3  pick 4bars
clip edison  = citizen-dj/loc-edison/The-stars-and-stripes-forever-march_00694038_002_00-01-55.wav  pick 4bars
clip stripes = marine-band/StarsAndStripesForever.mp3  pick 4bars

chords iv*4
chords i*2 VI*2
chords V*2 i*2

track stripes  role root
track cotton   role fifth  gain -2
track bugle    role third  every 2bars  gain -3
track edison   role chord  gain -1
